<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="47-create-daily-challenge" author="antigravity">
        <createTable tableName="daily_challenge">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="challenge_bank_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_dc_challenge_bank" referencedTableName="challenge_bank" referencedColumnNames="id"/>
            </column>
            <column name="challenge_date" type="DATE">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="skill_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="daily_challenge" indexName="idx_dc_date">
            <column name="challenge_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
