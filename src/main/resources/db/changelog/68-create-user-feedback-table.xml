<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="68-create-user-feedback-table" author="antigravity">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="user_feedback"/>
            </not>
        </preConditions>
        <createTable tableName="user_feedback">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sender_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_user_feedback_sender"
                             referencedTableName="account"
                             referencedColumnNames="id"/>
            </column>
            <column name="category" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="screenshot_url" type="TEXT"/>
            <column name="admin_note" type="TEXT"/>
            <column name="created_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(50)"/>
            <column name="updated_by" type="VARCHAR(50)"/>
        </createTable>

        <createIndex tableName="user_feedback" indexName="idx_user_feedback_sender_id">
            <column name="sender_id"/>
        </createIndex>

        <createIndex tableName="user_feedback" indexName="idx_user_feedback_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
