<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Adds `last_active_at` (TIMESTAMP) to the `account` table,
        used to track the last activity time of a user.
    -->
    <changeSet id="80-add-last-active-at-to-account" author="antigravity">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="account" columnName="last_active_at"/>
            </not>
        </preConditions>
        <addColumn tableName="account">
            <column name="last_active_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
