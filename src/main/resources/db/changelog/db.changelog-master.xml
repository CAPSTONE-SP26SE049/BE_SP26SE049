<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <include file="db/changelog/30-add-classroom-extended-fields.xml"/>

    <changeSet id="29-rename-classroom-max-students" author="antigravity">
        <renameColumn
                tableName="classroom"
                oldColumnName="max_students"
                newColumnName="current_students"
                columnDataType="INTEGER"/>
    </changeSet>

    <changeSet id="31-add-region-to-challenge-bank" author="antigravity">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="challenge_bank" columnName="region"/>
            </not>
        </preConditions>
        <addColumn tableName="challenge_bank">
            <column name="region" type="VARCHAR(20)" defaultValue="BAC">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
