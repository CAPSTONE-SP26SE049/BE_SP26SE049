<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="18-consolidate-user-profile" author="antigravity">
        <!-- 1. Add columns to account table from user_profile -->
        <addColumn tableName="account">
            <column name="full_name" type="VARCHAR(255)"/>
            <column name="avatar_url" type="VARCHAR(500)"/>
            <column name="total_stars" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="current_streak_days" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_experience" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="max_streak_days" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="last_activity_date" type="DATE"/>
        </addColumn>

        <!-- 2. Migrate data from user_profile to account -->
        <sql>
            UPDATE account a
            SET 
                full_name = p.full_name,
                avatar_url = p.avatar_url,
                total_stars = p.total_stars,
                current_streak_days = p.current_streak_days,
                total_experience = p.total_experience,
                max_streak_days = p.max_streak_days,
                last_activity_date = p.last_activity_date
            FROM user_profile p
            WHERE a.id = p.account_id;
        </sql>

        <!-- 3. Drop user_profile table after data migration -->
        <dropTable tableName="user_profile"/>
    </changeSet>

</databaseChangeLog>
