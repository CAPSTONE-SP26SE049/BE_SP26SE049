<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="52-rename-gemini-columns-to-groq" author="antigravity">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="speaking_attempt" columnName="gemini_score"/>
        </preConditions>

        <renameColumn
                tableName="speaking_attempt"
                oldColumnName="gemini_score"
                newColumnName="groq_score"
                columnDataType="INTEGER"/>

        <renameColumn
                tableName="speaking_attempt"
                oldColumnName="gemini_feedback"
                newColumnName="groq_feedback"
                columnDataType="TEXT"/>
    </changeSet>

</databaseChangeLog>
