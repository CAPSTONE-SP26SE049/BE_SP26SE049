<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="21-add-quiz-attempt-to-attempt" author="antigravity">
        <addColumn tableName="attempt">
            <column name="quiz_attempt_id" type="UUID"/>
        </addColumn>

        <addForeignKeyConstraint baseColumnNames="quiz_attempt_id"
                                 baseTableName="attempt"
                                 constraintName="fk_attempt_quiz_attempt"
                                 referencedColumnNames="id"
                                 referencedTableName="quiz_attempt"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
