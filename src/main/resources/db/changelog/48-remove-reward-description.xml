<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Remove description from reward_catalog as per user request -->
    <changeSet id="48-remove-reward-description" author="antigravity">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="reward_catalog" columnName="description"/>
        </preConditions>
        <dropColumn tableName="reward_catalog" columnName="description"/>
    </changeSet>

</databaseChangeLog>
